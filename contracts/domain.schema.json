{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "高原研学资源兑现领域事件",
  "description": "课程版本、学校团队、资源窗口、预约容量、替代确认、环节证据、劳务与费用结算、隐私同意之间的事件交换契约。枚举值为稳定接口，新增事件只能追加，不得改写既有语义。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "$ref": "#/$defs/event_type"
    },
    "aggregate_type": {
      "$ref": "#/$defs/aggregate_type"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "同一聚合内单调递增的版本号"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "事件载荷，形状由 event_type 决定，见 allOf 中的约束"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "event_type": {
      "type": "string",
      "enum": [
        "PROGRAM_PUBLISHED",
        "PROGRAM_BOOKED",
        "INSTRUCTOR_QUALIFIED",
        "BOOKING_REQUESTED",
        "STAFF_DUTY_ASSIGNED",
        "HEALTH_GUIDANCE_ISSUED",
        "RESOURCE_WINDOW_DECLARED",
        "RESOURCE_BLOCKED",
        "RESERVATION_REJECTED",
        "RESOURCE_RESERVED",
        "CONSENT_RECORDED",
        "SUBSTITUTION_PROPOSED",
        "SUBSTITUTION_ACCEPTED",
        "SUBSTITUTION_REJECTED",
        "ACTIVITY_RECORDED",
        "OFFLINE_BATCH_SYNCHRONIZED",
        "ACTIVITY_VERIFIED",
        "LABOR_RECORDED",
        "LABOR_SETTLED",
        "BOOKING_CANCELLED",
        "FEE_SETTLED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "curriculum_revision",
        "personnel_profile",
        "study_booking",
        "resource_window",
        "resource_reservation",
        "privacy_consent",
        "substitution",
        "activity_evidence",
        "labor_settlement",
        "fee_settlement"
      ]
    },
    "resource_kind": {
      "type": "string",
      "enum": ["crop_field", "greenhouse", "vehicle", "instructor"],
      "description": "预约时必须同事务校验的四类资源：作物、空间（场馆）、车辆、人员"
    },
    "check_dimension": {
      "type": "string",
      "enum": ["crop", "personnel", "space", "safety"],
      "description": "作物成熟与禁入、人员资质与占用、场馆车辆容量、高原安全容量四个校验维度"
    },
    "blockage_reason": {
      "type": "string",
      "enum": [
        "road_closure",
        "farming_no_entry",
        "crop_unripe",
        "personnel_occupied",
        "venue_closed",
        "safety_hazard"
      ]
    },
    "activity_type": {
      "type": "string",
      "enum": ["seed_observation", "soilless_culture", "picking", "workshop", "field_tour"]
    },
    "consent_scope": {
      "type": "string",
      "enum": ["media_usage", "child_data_on_duty"],
      "description": "media_usage：影像用途同意，须按用途逐项授权；child_data_on_duty：儿童资料仅向当班人员开放"
    },
    "evidence_type": {
      "type": "string",
      "enum": ["observation_sheet", "photo", "group_signature", "harvest_record", "sensor_reading"]
    },
    "sync_result": {
      "type": "string",
      "enum": ["accepted", "duplicate"],
      "description": "离线批次回传时按 client_record_id 幂等去重；duplicate 不重复计课时或工资"
    },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "disputed"]
    },
    "payload_PROGRAM_PUBLISHED": {
      "type": "object",
      "required": ["curriculum_id", "revision", "stage_targets", "activities", "price_items"],
      "properties": {
        "curriculum_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "stage_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stage", "objective_code", "objective"],
            "properties": {
              "stage": { "type": "string", "minLength": 1 },
              "objective_code": { "type": "string", "pattern": "^OBJ-" },
              "objective": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["activity_code", "title", "activity_type", "required", "needs", "objective_codes"],
            "properties": {
              "activity_code": { "type": "string", "pattern": "^ACT-" },
              "title": { "type": "string" },
              "activity_type": { "$ref": "#/$defs/activity_type" },
              "required": { "type": "boolean" },
              "needs": {
                "type": "array",
                "items": { "$ref": "#/$defs/resource_kind" },
                "minItems": 1
              },
              "objective_codes": {
                "type": "array",
                "items": { "type": "string", "pattern": "^OBJ-" },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "price_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item_code", "title", "unit_price", "unit"],
            "properties": {
              "item_code": { "type": "string", "pattern": "^PRICE-" },
              "title": { "type": "string" },
              "unit_price": { "type": "number", "minimum": 0 },
              "unit": { "type": "string", "enum": ["group", "person", "vehicle", "session"] },
              "activity_code": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "payload_INSTRUCTOR_QUALIFIED": {
      "type": "object",
      "required": ["staff_id", "qualification_codes", "valid_from", "valid_until", "activity_types"],
      "properties": {
        "staff_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "qualification_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "activity_types": { "type": "array", "items": { "$ref": "#/$defs/activity_type" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "payload_BOOKING_REQUESTED": {
      "type": "object",
      "required": [
        "booking_id",
        "school_id",
        "curriculum_id",
        "revision",
        "scheduled_date",
        "groups",
        "participant_counts",
        "authorized_confirmer_ids"
      ],
      "properties": {
        "booking_id": { "type": "string", "minLength": 1 },
        "school_id": { "type": "string", "minLength": 1 },
        "school_name": { "type": "string" },
        "curriculum_id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "scheduled_date": { "type": "string", "format": "date" },
        "slot": { "type": "string" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["group_id", "name"],
            "properties": {
              "group_id": { "type": "string" },
              "name": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "participant_counts": {
          "type": "object",
          "required": ["students", "teachers", "chaperones"],
          "properties": {
            "students": { "type": "integer", "minimum": 1 },
            "teachers": { "type": "integer", "minimum": 0 },
            "chaperones": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "authorized_confirmer_ids": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "有权代表学校确认替代方案与费用兑现的人员"
        },
        "requirements": { "type": "string" }
      },
      "additionalProperties": false
    },
    "payload_STAFF_DUTY_ASSIGNED": {
      "type": "object",
      "required": ["booking_id", "assignments"],
      "properties": {
        "booking_id": { "type": "string" },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["staff_id", "role", "duty_start", "duty_end"],
            "properties": {
              "staff_id": { "type": "string" },
              "name": { "type": "string" },
              "role": { "type": "string", "enum": ["lead_teacher", "instructor", "nurse", "chaperone", "driver"] },
              "duty_start": { "type": "string", "format": "date-time" },
              "duty_end": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "payload_HEALTH_GUIDANCE_ISSUED": {
      "type": "object",
      "required": ["booking_id", "tips", "acknowledged_by_school"],
      "properties": {
        "booking_id": { "type": "string" },
        "tips": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "text"],
            "properties": {
              "code": { "type": "string", "enum": ["altitude", "allergy", "medication", "sun_exposure", "chaperone_ratio", "emergency_contact"] },
              "text": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "acknowledged_by_school": { "type": "boolean" },
        "emergency_plan_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "payload_RESOURCE_WINDOW_DECLARED": {
      "type": "object",
      "required": ["resource_id", "kind", "capacity_per_slot", "slot_start", "slot_end", "accessible"],
      "properties": {
        "resource_id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/resource_kind" },
        "title": { "type": "string" },
        "location": { "type": "string" },
        "capacity_per_slot": { "type": "integer", "minimum": 0 },
        "slot_start": { "type": "string", "format": "date-time" },
        "slot_end": { "type": "string", "format": "date-time" },
        "accessible": { "type": "boolean", "description": "false 表示试验田处于禁入阶段等不可接待状态" },
        "crop_stage": { "type": "string", "enum": ["sowing", "growing", "ripe", "harvested", "fallow"] },
        "growth_window_start": { "type": "string", "format": "date" },
        "growth_window_end": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "payload_RESOURCE_BLOCKED": {
      "type": "object",
      "required": ["resource_id", "reason", "starts_at"],
      "properties": {
        "resource_id": { "type": "string" },
        "reason": { "$ref": "#/$defs/blockage_reason" },
        "starts_at": { "type": "string", "format": "date-time" },
        "ends_at": { "type": ["string", "null"], "format": "date-time" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "payload_RESERVATION_REJECTED": {
      "type": "object",
      "required": ["reservation_id", "booking_id", "failed_dimensions", "reasons"],
      "properties": {
        "reservation_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "failed_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/check_dimension" },
          "minItems": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "reason"],
            "properties": {
              "dimension": { "$ref": "#/$defs/check_dimension" },
              "resource_id": { "type": "string" },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "payload_RESOURCE_RESERVED": {
      "type": "object",
      "required": ["reservation_id", "booking_id", "slot_start", "slot_end", "checks", "allocations"],
      "properties": {
        "reservation_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "slot_start": { "type": "string", "format": "date-time" },
        "slot_end": { "type": "string", "format": "date-time" },
        "checks": {
          "type": "object",
          "description": "作物、人员、空间、安全四维必须在同一事务内全部通过",
          "required": ["crop", "personnel", "space", "safety"],
          "properties": {
            "crop": { "type": "string", "enum": ["passed"] },
            "personnel": { "type": "string", "enum": ["passed"] },
            "space": { "type": "string", "enum": ["passed"] },
            "safety": { "type": "string", "enum": ["passed"] }
          },
          "additionalProperties": false
        },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["resource_kind", "resource_id", "capacity_used", "capacity_limit"],
            "properties": {
              "resource_kind": { "$ref": "#/$defs/resource_kind" },
              "resource_id": { "type": "string" },
              "activity_code": { "type": "string" },
              "capacity_used": { "type": "integer", "minimum": 1 },
              "capacity_limit": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "payload_CONSENT_RECORDED": {
      "type": "object",
      "required": ["consent_id", "booking_id", "scope", "granted", "purposes", "granted_by", "granted_at"],
      "properties": {
        "consent_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "scope": { "$ref": "#/$defs/consent_scope" },
        "granted": { "type": "boolean" },
        "purposes": {
          "type": "array",
          "items": { "type": "string", "enum": ["activity_evidence", "school_report", "marketing", "safety_care"] },
          "minItems": 1,
          "description": "marketing 与 activity_evidence 等用途必须分别授权；营销默认不在授权范围"
        },
        "granted_by": { "type": "string", "enum": ["guardian", "school"] },
        "granted_at": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "payload_SUBSTITUTION_PROPOSED": {
      "type": "object",
      "required": [
        "substitution_id",
        "booking_id",
        "replaces",
        "replacement",
        "objective_codes",
        "equivalence_note"
      ],
      "properties": {
        "substitution_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "reservation_id": { "type": "string" },
        "replaces": {
          "type": "object",
          "required": ["resource_kind", "activity_code"],
          "properties": {
            "resource_kind": { "$ref": "#/$defs/resource_kind" },
            "resource_id": { "type": "string" },
            "activity_code": { "type": "string" }
          },
          "additionalProperties": false
        },
        "replacement": {
          "type": "object",
          "required": ["resource_kind", "resource_id"],
          "properties": {
            "resource_kind": { "$ref": "#/$defs/resource_kind" },
            "resource_id": { "type": "string" }
          },
          "additionalProperties": false
        },
        "objective_codes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^OBJ-" },
          "minItems": 1,
          "description": "替代方案必须逐目标说明等值性"
        },
        "equivalence_note": { "type": "string", "minLength": 1 },
        "fee_delta_preview": { "type": "number" }
      },
      "additionalProperties": false
    },
    "payload_SUBSTITUTION_ACCEPTED": {
      "type": "object",
      "required": ["substitution_id", "booking_id", "confirmed_by", "confirmed_at"],
      "properties": {
        "substitution_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "confirmed_by": {
          "type": "string",
          "description": "必须是 BOOKING_REQUESTED.authorized_confirmer_ids 中的学校人员"
        },
        "confirmed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "payload_SUBSTITUTION_REJECTED": {
      "type": "object",
      "required": ["substitution_id", "booking_id", "rejected_by", "reason", "rejected_at"],
      "properties": {
        "substitution_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "rejected_by": { "type": "string" },
        "reason": { "type": "string" },
        "rejected_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "payload_ACTIVITY_RECORDED": {
      "type": "object",
      "required": [
        "evidence_id",
        "booking_id",
        "group_id",
        "activity_code",
        "resource_id",
        "started_at",
        "ended_at",
        "evidence_types",
        "recorded_offline"
      ],
      "properties": {
        "evidence_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "group_id": { "type": "string" },
        "activity_code": { "type": "string" },
        "instructor_id": { "type": "string" },
        "resource_id": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "evidence_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_type" },
          "minItems": 1,
          "description": "每个环节保留自己的证据；签到本身不能替代其他环节证据"
        },
        "recorded_offline": { "type": "boolean" },
        "client_record_id": {
          "type": "string",
          "description": "离线记录幂等键，回传去重的依据"
        }
      },
      "additionalProperties": false
    },
    "payload_OFFLINE_BATCH_SYNCHRONIZED": {
      "type": "object",
      "required": ["batch_id", "booking_id", "synced_at", "items"],
      "properties": {
        "batch_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "synced_at": { "type": "string", "format": "date-time" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["record_type", "client_record_id", "result"],
            "properties": {
              "record_type": { "type": "string", "enum": ["activity", "labor"] },
              "client_record_id": { "type": "string" },
              "result": { "$ref": "#/$defs/sync_result" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "payload_ACTIVITY_VERIFIED": {
      "type": "object",
      "required": ["evidence_id", "booking_id", "group_id", "activity_code", "status", "verified_by"],
      "properties": {
        "evidence_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "group_id": { "type": "string" },
        "activity_code": { "type": "string" },
        "status": { "$ref": "#/$defs/verification_status" },
        "verified_by": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "payload_LABOR_RECORDED": {
      "type": "object",
      "required": ["labor_record_id", "booking_id", "worker_id", "contractor_id", "activity_code", "work_minutes", "rate_per_hour", "recorded_offline"],
      "properties": {
        "labor_record_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "worker_id": { "type": "string" },
        "worker_name": { "type": "string" },
        "contractor_id": { "type": "string" },
        "activity_code": { "type": "string" },
        "work_minutes": { "type": "integer", "minimum": 1 },
        "rate_per_hour": { "type": "number", "minimum": 0 },
        "recorded_offline": { "type": "boolean" },
        "client_record_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "payload_LABOR_SETTLED": {
      "type": "object",
      "required": ["settlement_id", "worker_id", "contractor_id", "booking_id", "lines", "total_minutes", "total_amount", "settled_at"],
      "properties": {
        "settlement_id": { "type": "string" },
        "worker_id": { "type": "string" },
        "contractor_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["labor_record_id", "work_minutes", "amount"],
            "properties": {
              "labor_record_id": { "type": "string" },
              "work_minutes": { "type": "integer" },
              "amount": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "total_minutes": { "type": "integer" },
        "total_amount": { "type": "number" },
        "settled_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "payload_BOOKING_CANCELLED": {
      "type": "object",
      "required": ["booking_id", "reason", "cancelled_at"],
      "properties": {
        "booking_id": { "type": "string" },
        "reason": { "type": "string" },
        "cancelled_at": { "type": "string", "format": "date-time" },
        "fee_handling_note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "payload_FEE_SETTLED": {
      "type": "object",
      "required": [
        "settlement_id",
        "booking_id",
        "charged_amount",
        "delivered",
        "canceled",
        "payable_amount",
        "refund_amount",
        "accounting_ref",
        "settled_at"
      ],
      "properties": {
        "settlement_id": { "type": "string" },
        "booking_id": { "type": "string" },
        "charged_amount": { "type": "number", "minimum": 0, "description": "学校已收费用总额" },
        "delivered": {
          "type": "array",
          "description": "真实提供、可结算的资源，每行须能追溯到环节证据或学校已确认的替代",
          "items": {
            "type": "object",
            "required": ["item_code", "quantity", "amount", "basis"],
            "properties": {
              "item_code": { "type": "string" },
              "activity_code": { "type": "string" },
              "group_id": { "type": "string", "description": "按小组兑现时填写；证据的 group_id 必须与本行一致" },
              "resource_id": { "type": "string" },
              "quantity": { "type": "number", "minimum": 0 },
              "amount": { "type": "number", "minimum": 0 },
              "basis": {
                "type": "object",
                "description": "兑现依据：activity_evidence（含 evidence_id）或 accepted_substitution（含 substitution_id）",
                "properties": {
                  "evidence_id": { "type": "string" },
                  "substitution_id": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "canceled": {
          "type": "array",
          "description": "未提供、不得结算的资源（课程取消或环节缺失）",
          "items": {
            "type": "object",
            "required": ["item_code", "amount"],
            "properties": {
              "item_code": { "type": "string" },
              "activity_code": { "type": "string" },
              "group_id": { "type": "string" },
              "amount": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "payable_amount": { "type": "number", "minimum": 0 },
        "refund_amount": { "type": "number", "minimum": 0 },
        "accounting_ref": { "type": "string" },
        "settled_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
