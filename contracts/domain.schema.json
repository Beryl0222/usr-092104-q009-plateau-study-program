{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "高原研学资源兑现领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROGRAM_BOOKED",
        "RESOURCE_RESERVED",
        "SUBSTITUTION_ACCEPTED",
        "ACTIVITY_VERIFIED",
        "LABOR_SETTLED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "curriculum_revision",
        "resource_window",
        "activity_evidence",
        "labor_settlement"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
